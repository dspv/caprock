# Normalize line endings: LF in the repo and in every checkout. Windows runners
# otherwise check out CRLF and gofmt/golangci-lint reject the files.
* text=auto eol=lf
*.go text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.png binary
*.jpg binary
*.gif binary
