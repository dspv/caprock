# the goreleaser root /dist/ above is ignored.
*.test

# Dependencies
node_modules/
vendor/

# Local Caprock data (dev)
.caprock/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Python (docs tooling)
__pycache__/
*.pyc
/caprock
/caprock-hook

# Screenshot fixture — a copy of a real database, rebuilt on demand.
scripts/shotdata/

# TypeScript incremental build cache — a local artifact, never shared.
*.tsbuildinfo
