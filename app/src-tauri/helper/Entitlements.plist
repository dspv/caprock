<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Caprock Terminal answers for what its terminals run (ADR-101), and
	     the hardened runtime denies the microphone, without a prompt, to a
	     responsible program signed without this (ADR-045). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
